{
  "author": "mudroljub",
  "license": "MIT",
  "name": "partisan-games",
  "version": "0.0.1",
  "description": "Small 2D and 3D browser games inspired by Yugoslav partisans and more.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:mudroljub/partisan-games.git"
  },
  "scripts": {
    "start": "npx live-server",
    "lint": "eslint --fix core core3d scenes ui catalog scripts tests config.js playwright.config.js",
    "test": "node --disable-warning=ExperimentalWarning --import ./tests/unit/setup/register.js --test \"tests/unit/**/*.test.js\"",
    "check": "node scripts/check-project.js",
    "smoke": "playwright test",
    "probe": "node scripts/probe.js",
    "verify": "npm run lint && npm test && npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.65.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  }
}
